# Local context documents (context/README.md files describe what belongs in
# each folder; actual content is often sensitive business data and is kept
# local rather than committed).
context/*/*
!context/*/README.md

# Generated output from examples/validate.py runs (raw transcripts, per-run
# summaries) — not source, safe to delete.
examples/.results/

# Byte-compiled Python (examples/validate.py is the one script in this repo)
__pycache__/
*.pyc

# OS/editor cruft
.DS_Store
Thumbs.db
